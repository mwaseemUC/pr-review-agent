+_DAILY_TOTALS_SQL = (
+    "SELECT created_at::date AS day, count(*), coalesce(sum(total_cents), 0) "
+    "FROM orders WHERE created_at::date BETWEEN %s AND %s "
+    "GROUP BY day ORDER BY day"
+)
 
 
